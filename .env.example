# ==============================================================================
# 1. SERVER-SIDE ENVIRONMENT VARIABLES (Render / Standalone Backend Server)
# ==============================================================================
# These variables must ONLY be configured on the backend server environment.
# The backend server is the SOLE authority for database and administration operations.
# NEVER expose these variables to the frontend or client browser bundle.

# Database Connectivity (Supabase PostgreSQL via Server)
SUPABASE_URL=https://ibuaiktnkhvqoqxrqnrz.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional service role key for backend administration
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server Runtime & Network
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=https://tomesphere.in,https://www.tomesphere.in,http://localhost:3000

# Backend Administrative Protection (Required for write / mutation endpoints)
ADMIN_SECRET=your-secure-admin-secret-key


# ==============================================================================
# 2. CLIENT & FRONTEND ENVIRONMENT VARIABLES (Vercel / Browser / Next.js)
# ==============================================================================
# These variables configure the frontend application.
# The frontend connects EXCLUSIVELY to the backend server API.
# Zero direct database access is allowed from the client.

# Public API URL (Exposed to the browser client)
# Points to the public address of your standalone server on Render
NEXT_PUBLIC_API_URL=https://api.tomesphere.in

# Server-Side Proxy / SSR Target (Next.js Node runtime only)
# Used by Next.js rewrites and server-side data fetching
BACKEND_API_URL=http://YOUR_EXTERNAL_SERVER_IP:5000
